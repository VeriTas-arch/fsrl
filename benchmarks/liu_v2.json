{
  "schema_version": 2,
  "protocol_id": "liu-constructive-ranking-v2-source-corrected",
  "correction_from_v1": {
    "reason": "Liu et al. define A < B < ... < H; v1 reversed the true order without reflecting the learned graph",
    "development_results_remain_bound_to": "liu-constructive-ranking-v1",
    "confirmation_required": true
  },
  "n_items": 8,
  "item_labels": ["A", "B", "C", "D", "E", "F", "G", "H"],
  "true_order_high_to_low": ["H", "G", "F", "E", "D", "C", "B", "A"],
  "support": {
    "pairs_higher_lower": [
      ["F", "A"],
      ["C", "B"],
      ["E", "B"],
      ["G", "C"],
      ["F", "D"],
      ["G", "D"],
      ["H", "E"],
      ["H", "A"]
    ],
    "source_unordered_pairs": [
      ["A", "F"],
      ["B", "C"],
      ["B", "E"],
      ["C", "G"],
      ["D", "F"],
      ["D", "G"],
      ["E", "H"],
      ["A", "H"]
    ],
    "blocks": 4,
    "trials": 32,
    "randomize_order_within_block": true,
    "randomize_left_right_orientation": true,
    "visible_magnitude": "rank_gap/(n_items-1)",
    "choice_required": false,
    "feedback": false
  },
  "query": {
    "all_unordered_pairs": true,
    "pairs_per_block": 28,
    "blocks": 10,
    "trials": 280,
    "randomize_order_within_block": true,
    "randomize_left_right_orientation": true,
    "feedback": false,
    "distance_input": false,
    "reset_hidden_each_trial": true,
    "reset_eligibility_each_trial": true,
    "fast_weights": "freeze_after_support",
    "time_channel": "constant_at_support_query_boundary",
    "time_value": 0.6666666666666666
  },
  "analysis": {
    "below_chance_exclusion": true,
    "exclude_correct_rankers_from_pair_distribution_analyses": true,
    "primary_metrics": [
      "overall_accuracy",
      "learned_accuracy",
      "nonlearned_accuracy",
      "symbolic_distance_slope",
      "ranking_class_counts",
      "self_consistency",
      "stable_error_prevalence",
      "pair_beta_classes",
      "inter_subject_kendall_tau"
    ]
  },
  "human_targets": {
    "source": "benchmarks/liu_human_exact_v1.json",
    "status": "must_be_generated_and_validated_before_confirmation_training"
  }
}

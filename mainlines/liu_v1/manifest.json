{
  "schema_version": 1,
  "mainline_id": "liu_v1",
  "status": "draft",
  "scope": "Model-level Liu task fidelity, behavioral competence, causal computation, algorithmic asymmetry, and prospectively registered one-factor transport. No human-neural implementation or new scientific estimand is introduced.",
  "design_principles": [
    "historical_experiment_is_not_mainline_orchestration_or_presentation",
    "motivated_by_is_not_depends_on",
    "historical_replay_is_not_live_head_validation"
  ],
  "claim_nodes": {
    "task_fidelity": {
      "depends_on": [],
      "motivated_by": [],
      "claim": "The model-facing contract preserves the Liu paradigm's available information: item identity plus signed displayed magnitude, four passive presentations per support relation, all-pair testing, and no learning response or test feedback.",
      "evidence": [
        "liu_protocol",
        "liu_human_benchmark",
        "liu_preregistered_trials",
        "liu_replication_trials"
      ],
      "boundary": "This node binds only the Liu paradigm. Classic rewarded adjacent-pair TI and list-linking tasks are research context, not factual prerequisites."
    },
    "behavioral_competence": {
      "depends_on": [
        "task_fidelity"
      ],
      "motivated_by": [],
      "claim": "The frozen model reproduces six of nine registered Liu phenomena quantitatively and the remaining three qualitatively with explicit quantitative mismatch.",
      "evidence": [
        "behavior_map_result",
        "behavior_map_report"
      ],
      "boundary": "Behavioral reproduction is a competence gate, not a human-mechanism claim or a perfect fit."
    },
    "global_reassembly": {
      "depends_on": [
        "task_fidelity"
      ],
      "motivated_by": [
        "global_only_direct_fidelity_deficit"
      ],
      "claim": "Selectively admitted evidence enters P_T, whose causal contribution supports coherent remote and nonlearned relational assembly.",
      "evidence": [
        "formal_mechanism_result",
        "local_replication_result",
        "dual_access_confirmation_result"
      ],
      "boundary": "P_T is a network computation, not a Bayesian update identity or a biological memory store."
    },
    "local_direct_fidelity": {
      "depends_on": [
        "task_fidelity"
      ],
      "motivated_by": [
        "scalar_gate_family_closed",
        "first_order_residual_family_closed"
      ],
      "claim": "Broader weak observed evidence enters L_T, equivalently represented by the exact edge-ledger coordinate a_T, and provides query-addressed direct fidelity without restoring global transitive inference when P_T is removed.",
      "evidence": [
        "local_replication_result",
        "dual_access_confirmation_result"
      ],
      "boundary": "The evidence supports functional separation, not unique tensor-product coding, biological stores, or network-population prevalence."
    },
    "algorithmic_asymmetry": {
      "depends_on": [
        "global_reassembly",
        "local_direct_fidelity"
      ],
      "motivated_by": [
        "mechanism_stack_compression"
      ],
      "claim": "The local path has an exact reduced edge-ledger algorithm, whereas three prospectively tested low-capacity reductions do not close the global learning dynamics even though the terminal global output geometry is nearly additive.",
      "evidence": [
        "reduced_algorithm_v1_result",
        "reduced_algorithm_v2_result",
        "reduced_algorithm_v3_result",
        "item_count_result"
      ],
      "boundary": "Simple output geometry does not imply simple learning dynamics; failed reductions reject their registered closure families, not all possible P_T-derived reductions."
    },
    "structural_transport": {
      "depends_on": [
        "global_reassembly",
        "local_direct_fidelity"
      ],
      "motivated_by": [
        "fixed_graph_lookup_table_alternative"
      ],
      "claim": "The P_T/a_T functional division transports across the registered one-factor support-topology, presentation-order, density, and N=6/8/10 item-count studies.",
      "evidence": [
        "topology_result",
        "presentation_order_result",
        "evidence_sparsity_result",
        "sparsity_localization_result",
        "item_count_result"
      ],
      "boundary": "These are sequential one-factor tests, not a full factorial, arbitrary graph, arbitrary schedule, or arbitrary-size guarantee. The sparsity parent outcome remains unresolved."
    },
    "claim_freeze": {
      "depends_on": [
        "behavioral_competence",
        "global_reassembly",
        "local_direct_fidelity",
        "algorithmic_asymmetry",
        "structural_transport"
      ],
      "motivated_by": [],
      "claim": "Liu v1 is a frozen model-level scientific object whose positive results, qualified negatives, provenance, artifacts, environment, and presentation view are preserved together.",
      "evidence": [
        "legacy_evidence_manifest",
        "legacy_claim_freeze",
        "legacy_mainline_synthesis"
      ],
      "boundary": "Any scientific claim change requires liu_v2; factual corrections require append-only errata."
    }
  },
  "research_lineage": [
    {
      "id": "global_only_direct_fidelity_deficit",
      "motivates": "local_direct_fidelity",
      "role": "The confirmed global channel transported remote inference but failed the full behavioral conjunction, motivating localization of direct-experience loss."
    },
    {
      "id": "scalar_gate_family_closed",
      "motivates": "local_direct_fidelity",
      "role": "Unsigned and policy-relative scalar amplitude gates were valid negatives and closed that intervention family."
    },
    {
      "id": "first_order_residual_family_closed",
      "motivates": "local_direct_fidelity",
      "role": "The first-order residual carried H>A/F>A information but was insufficient, motivating a separately persistent local state."
    },
    {
      "id": "mechanism_stack_compression",
      "motivates": "algorithmic_asymmetry",
      "role": "The replicated P_T/L_T mechanism motivated testing whether the evidence stack could be compressed into an executable reduced algorithm."
    },
    {
      "id": "fixed_graph_lookup_table_alternative",
      "motivates": "structural_transport",
      "role": "Transport tests distinguish a task algorithm from one fixed support graph or schedule."
    }
  ],
  "reference_context": {
    "Miconi_and_Kay": "Research lineage and model ancestry only; their rewarded adjacent-pair episode is outside the Liu fact DAG.",
    "Lippl_et_al": "Theoretical context for classic TI representation and norm-minimization arguments only.",
    "Nelli_et_al": "Knowledge-reassembly context and a future list-linking program only."
  },
